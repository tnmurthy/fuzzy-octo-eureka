{
  "name": "agency-watchdog-alert",
  "nodes": [
    {
      "id": "schedule1",
      "name": "Hourly Watchdog Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-500, -80],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "webhook1",
      "name": "Alert Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-500, 120],
      "parameters": {
        "path": "agency-alert",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "status_check",
      "name": "Check Patrol Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 20],
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8787/api/patrol/status",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "runs_check",
      "name": "Fetch Recent Runs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 20],
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8787/api/runs",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "eval_health",
      "name": "Evaluate Agency Health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 20],
      "parameters": {
        "jsCode": "const statusData = $('Check Patrol Status').first().json;\nconst runsData = $input.first().json.runs || [];\n\nconst failedRuns = runsData.filter(r => r.status === 'failed' || r.status === 'error');\nconst activeRuns = runsData.filter(r => r.status === 'running');\nconst latestMantis = statusData.latestMantisRun;\n\nconst isHealthy = failedRuns.length === 0;\nconst summary = `Agency Health: ${isHealthy ? 'OPTIMAL' : 'ATTENTION REQUIRED'} | Active Runs: ${activeRuns.length} | Failed Runs: ${failedRuns.length} | Mantis Last Run: ${latestMantis ? latestMantis.status : 'None'}`;\n\nreturn [{\n  json: {\n    ok: true,\n    isHealthy,\n    summary,\n    activeCount: activeRuns.length,\n    failedCount: failedRuns.length,\n    latestMantisId: latestMantis ? latestMantis.id : null,\n    timestamp: new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "respond_alert",
      "name": "Respond with Alert Status",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [480, 20],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "Hourly Watchdog Schedule": {
      "main": [
        [
          {
            "node": "Check Patrol Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert Webhook Trigger": {
      "main": [
        [
          {
            "node": "Check Patrol Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Patrol Status": {
      "main": [
        [
          {
            "node": "Fetch Recent Runs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Recent Runs": {
      "main": [
        [
          {
            "node": "Evaluate Agency Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Agency Health": {
      "main": [
        [
          {
            "node": "Respond with Alert Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
