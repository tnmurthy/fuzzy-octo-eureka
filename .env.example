# Copy to .env (gitignored) and fill in. Read by server.js and
# telemetry-daemon.ps1 at startup. One .env per person's install.

# --- Who this install belongs to (required) ---------------------------------
# Your name, shown in dashboard greetings.
OPERATOR_NAME=
# Your Windows profile folder. Required: the services run as LocalSystem, whose
# own profile is not yours, and agent runs need your CLI logins from here.
OPERATOR_HOME=C:\Users\<you>

# --- Paths (optional; defaults shown) ----------------------------------------
# Root of the stack checkout (three levels above this folder).
# STACK_ROOT=C:\tt-ai-stack
# Folder whose git repos agents may be dispatched into (this folder's parent).
# PROJECTS_DIR=C:\tt-ai-stack\01_projects\active
# Agent run log, read by the Agent Runs tab and n8n.
# AGENT_RUNS_FILE=C:\tt-ai-stack\04_internal\agent-runs\runs.jsonl
# git-bash used to run orchestration/agent-dispatch.sh.
# DISPATCH_BASH_BIN=C:\Program Files\Git\bin\bash.exe
# OpenClaw CLI shim (default: <OPERATOR_HOME>\AppData\Roaming\npm\openclaw.cmd).
# OPENCLAW_BIN=

# --- Server (optional) -------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1

# --- Only if you publish the dashboard through Cloudflare Access -------------
# ACCESS_TEAM_DOMAIN=
# ACCESS_AUD=
# PUBLIC_HOSTNAMES=
# ACCESS_ALLOWED_EMAILS=
