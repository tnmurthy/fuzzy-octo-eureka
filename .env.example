# Copy to .env (gitignored) and fill in. Read by server.js and
# telemetry-daemon.ps1 at startup. One .env per person's install.

# --- Who this install belongs to (required) ---------------------------------
# Your name, shown in dashboard greetings.
OPERATOR_NAME=
# Your Windows profile folder. Required: the services run as LocalSystem, whose
# own profile is not yours, and agent runs need your CLI logins from here.
OPERATOR_HOME=C:\Users\<you>

# --- Paths (optional; defaults shown) ----------------------------------------
# Root of the stack checkout (three levels above this folder).
# STACK_ROOT=C:\tt-ai-stack
# Folder whose git repos agents may be dispatched into (this folder's parent).
# PROJECTS_DIR=C:\tt-ai-stack\01_projects\active
# Agent run log, read by the Agent Runs tab and n8n.
# AGENT_RUNS_FILE=C:\tt-ai-stack\04_internal\agent-runs\runs.jsonl
# git-bash used to run orchestration/agent-dispatch.sh.
# DISPATCH_BASH_BIN=C:\Program Files\Git\bin\bash.exe
# OpenClaw CLI shim (default: <OPERATOR_HOME>\AppData\Roaming\npm\openclaw.cmd).
# OPENCLAW_BIN=

# Memory search by meaning with local embeddings (cached in logs/).
# false = keyword scoring only. Needs `ollama pull nomic-embed-text`.
# MEMORY_EMBEDDINGS=true
# EMBED_MODEL=nomic-embed-text

# --- Remote Compute Offloading (e.g. Mac Studio on LAN or Tailscale) ---------
# Offload local model inference (personas, routing, embeddings, local agents)
# to a remote machine like a Mac Studio to save compute and frontier tokens.
# Default is 127.0.0.1 (local). Set to your Mac Studio IP, hostname, or Tailscale IP.
# OLLAMA_HOST=127.0.0.1
# OLLAMA_PORT=11434

# --- Local-first dispatch (optional) ---------------------------------------
# true: a dispatch to claude runs as `auto` - the local agent (LOCAL_AGENT,
# default hermes) tries first and claude runs only if the repo's tests fail.
# A repo opts in with a one-line test command in .arunachala-test, or an npm
# test script; repos without tests always go straight to claude.
# DISPATCH_LOCAL_FIRST=false
# LOCAL_AGENT=hermes
# LOCAL_TIMEOUT=900
# TEST_TIMEOUT=900
#
# Dispatched claude runs: model, turn limit, and lean context (no MCP
# servers, skills or user settings - ~64k -> ~39k tokens loaded per run).
# CLAUDE_MODEL=sonnet
# CLAUDE_MAX_TURNS=40
# CLAUDE_LEAN=true
# Add the 3 most relevant team memories (this repo + global) to each dispatch
# prompt, capped at 1500 characters; false = task only.
# DISPATCH_MEMORY_CONTEXT=true

# --- Server (optional) -------------------------------------------------------
# Persona chat model (Ollama). gemma3:4b suits a CPU-only laptop; qwen2.5:7b
# is better but ~2x slower - use it only with a GPU.
# PERSONA_MODEL=gemma3:4b
# Max tokens per persona answer (keeps replies inside the 45 s timeout).
# PERSONA_MAX_TOKENS=400
# PORT=8787
# HOST=127.0.0.1

# --- Only if you publish the dashboard through Cloudflare Access -------------
# ACCESS_TEAM_DOMAIN=
# ACCESS_AUD=
# PUBLIC_HOSTNAMES=
# ACCESS_ALLOWED_EMAILS=

# --- Secrets kept outside the project folder (optional) ---------------------
# A second env file loaded after this one, e.g. the team login password:
# SECRETS_ENV_FILE=C:\tt-ai-stack\04_internal\secrets\arunachala-team.env
# (that file: SUPABASE_PASSWORD=...). A key set here wins over that file.

# --- Shared team context in Supabase (optional; all five or none) -----------
# Off when unset: everything stays in local files. When set, this install's
# agent runs sync to the team every 30 s and /api/runs?scope=team shows the
# whole team's runs. Sign in as YOUR OWN Supabase user - never a service key.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_EMAIL=
# SUPABASE_PASSWORD=
# TEAM_ID=
