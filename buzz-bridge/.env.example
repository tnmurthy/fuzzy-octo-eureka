# Copy to .env (gitignored) and fill in. Read by bridge.js at startup.

# --- Who this bridge obeys (required) ----------------------------------------
# Your Buzz pubkey(s), hex, comma-separated. The bot ignores everyone else.
BUZZ_OPERATORS=
# Display name of your bot. Make it unique per person ("Ravi's Team"), so a
# mention in a shared channel reaches the right teammate's bridge.
BUZZ_BOT_NAME=
# Channel ids (the #h tag) the bot listens to, comma-separated.
BUZZ_BOT_CHANNELS=

# --- Relay -------------------------------------------------------------------
# ws(s) URL of the Buzz relay. Use this name, not BUZZ_RELAY_URL.
BRIDGE_RELAY_URL=wss://buzz.mytestbed.tech
# The bot's own secret key. Leave empty: generated and saved here on first start.
# BUZZ_BOT_SECRET_KEY=

# --- Routing -----------------------------------------------------------------
# local (Ollama, free, default) or typesafe (cloud, needs TYPESAFE_API_KEY).
# BUZZ_ROUTER=local
# LOCAL_ROUTER_MODEL=gemma3:4b
# LOCAL_ROUTER_FALLBACK_MODEL=qwen2.5-coder:3b

# TypeSafe System One key - https://typesafe.ai account settings.
TYPESAFE_API_KEY=
# Max billable TypeSafe calls per day (counted from logs/typesafe-ledger.jsonl).
TYPESAFE_DAILY_CAP=200

# --- Dispatch ----------------------------------------------------------------
# n8n webhook that starts an agent run.
# N8N_DISPATCH_WEBHOOK_URL=http://127.0.0.1:5678/webhook/buzz-dispatch
# BRIDGE_NOTIFY_PORT=3100
