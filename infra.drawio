  <diagram id="qOcXQuNRzdratWQ3UJi5" name="Page-3">
    <mxGraphModel dx="4412" dy="2056" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\n\n    sequenceDiagram\n        autonumber\n        actor User as Browser / Frontend\n        participant Server as server.js\n        participant ReBAC as rebac-engine.js\n        participant FileSys as Disk Storage\n        participant Daemon as telemetry-daemon.ps1\n        participant Docker as Docker Daemon\n        participant Ollama as Ollama Server\n\n        %% Background Daemon Loop\n        Note over Daemon,Ollama: Background Polling Cycle (Every 5s)\n        Daemon-&gt;&gt;Ollama: Test-TcpPortOpen &amp; GET /api/tags\n        Ollama--&gt;&gt;Daemon: 200 OK + Latency (ms) + Active Models\n        Daemon-&gt;&gt;Docker: docker ps (Filter: watchtower)\n        Docker--&gt;&gt;Daemon: Container Name, Status (\&quot;Up 3 hours\&quot;), Image\n        Daemon-&gt;&gt;Daemon: Sample Host CPU via CIM/WMI\n        Daemon-&gt;&gt;FileSys: Write-AtomicJsonFile (telemetry.json.tmp -&gt; telemetry.json)\n        Daemon-&gt;&gt;FileSys: Write-AtomicJsonFile (Append history.json)\n\n        %% Frontend Polling\n        Note over User,Server: Frontend UI Cycle (Every 3s)\n        User-&gt;&gt;Server: GET /api/telemetry\n        Server-&gt;&gt;FileSys: Read telemetry.json\n        FileSys--&gt;&gt;Server: JSON Snapshot Payload\n        Server--&gt;&gt;User: 200 OK { cpu, services, activeModels, watchtower, agentStats }\n        User-&gt;&gt;User: updateCpuMetrics(), updateServiceDots(), updateEngineStatsPanel()\n\n        %% On-Demand Interactive Ping Handshake\n        Note over User,Ollama: User Clicks \&quot;⚡ Test Handshake\&quot; Button\n        User-&gt;&gt;Server: GET /api/ping\n        Server-&gt;&gt;ReBAC: canAccess(\&quot;user:sriad\&quot;, \&quot;ping:execute\&quot;, \&quot;resource:ollama_cluster\&quot;)\n        ReBAC--&gt;&gt;Server: { authorized: true, path: [\&quot;user:sriad\&quot;, \&quot;MEMBER_OF\&quot;, \&quot;team:opscore\&quot;, ...] }\n        alt Authorization Granted\n            Server-&gt;&gt;Ollama: GET /api/tags (Timeout: 3000ms)\n            Ollama--&gt;&gt;Server: 200 OK (models: [...])\n            Server--&gt;&gt;User: 200 OK { ok: true, latencyMs: 3, models: [...] }\n            User-&gt;&gt;User: Display ping response in Terminal / Action Log\n        else Authorization Denied\n            Server--&gt;&gt;User: 403 Forbidden { ok: false, error: \&quot;ReBAC authorization denied\&quot; }\n        end\n &quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="w522gOOx_kausbACwaw--1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
