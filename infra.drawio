    <mxGraphModel dx="694" dy="628" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD                                                                                                     \n        %% ==========================================                                                                \n        %% GOVERNANCE &amp; LEADERSHIP                                                                                   \n        %% ==========================================                                                                \n        subgraph GOV[\&quot;1. Governance &amp; Leadership Layer\&quot;]                                                             \n            CHAIRMAN[\&quot;Human: Chairman&lt;br/&gt;(Strategic Intent, Boundaries, Final Approvals)\&quot;]                          \n            CEO[\&quot;AI Leader / CEO Agent&lt;br/&gt;(Task Decomposition, Resource Allocation, Meeting Chair)\&quot;]                \n            CHAIRMAN &lt;--&gt;|\&quot;Directives &amp; Escalations\&quot;| CEO                                                            \n        end                                                                                                          \n                                                                                                                     \n        %% ==========================================                                                                \n        %% STRUCTURED MEETING ENGINE                                                                                 \n        %% ==========================================                                                                \n        subgraph MEETINGS[\&quot;2. Structured Meeting &amp; Consensus Engine\&quot;]                                                \n            DACI[\&quot;DACI Decision Protocol&lt;br/&gt;(Driver · Approver · Contributor · Informed)\&quot;]                          \n            HATS[\&quot;Six Thinking Hats Debate&lt;br/&gt;(Advocate vs Critic · Stress Testing)\&quot;]                               \n            DECISION_LOG[(\&quot;decisions.md&lt;br/&gt;Binding Architecture Ledger\&quot;)]                                           \n                                                                                                                     \n            CEO --&gt;|\&quot;Trigger on Complex Architecture\&quot;| DACI                                                          \n            DACI &lt;--&gt;|\&quot;Multi-Perspective Review\&quot;| HATS                                                               \n            HATS --&gt;|\&quot;Ratified Decision\&quot;| DECISION_LOG                                                               \n        end                                                                                                          \n                                                                                                                     \n        %% ==========================================                                                                \n        %% TASK WALL &amp; WATCHDOG                                                                                      \n        %% ==========================================                                                                \n        subgraph TASKWALL[\&quot;3. Event-Driven Task Wall &amp; Deadlock Guard\&quot;]                                              \n            WALL[\&quot;Dynamic Task Wall&lt;br/&gt;(Pending · In-Progress · Blocked · Review)\&quot;]                                 \n            WATCHDOG[\&quot;Agent Watchdog &amp; Loop Breaker&lt;br/&gt;(Timeout Patrol · Deadlock Detection · Anti-IAL)\&quot;]           \n                                                                                                                     \n            CEO --&gt;|\&quot;Push Decomposed Tasks\&quot;| WALL                                                                    \n            DECISION_LOG -.-&gt;|\&quot;Constraints &amp; Specs\&quot;| WALL                                                            \n            WATCHDOG &lt;--&gt;|\&quot;Detect Stalls &amp; Circular Waits\&quot;| WALL                                                     \n        end                                                                                                          \n                                                                                                                     \n        %% ==========================================                                                                \n        %% EXECUTION &amp; LIFECYCLE HOOKS                                                                               \n        %% ==========================================                                                                \n        subgraph EXEC[\&quot;4. Execution Engine with Lifecycle Hooks\&quot;]                                                    \n            HOOKS[\&quot;10 Lifecycle Hooks&lt;br/&gt;• PreCompact: Snapshot in-flight state&lt;br/&gt;• TurnEndGuard: Block exit if   \n            background jobs run&lt;br/&gt;• SubagentStart: Inject 2-action rule&lt;br/&gt;• PermissionDenied: Auto-recovery      \n            path\&quot;]                                                                                                   \n            ROLES[\&quot;Least-Privilege Role Hardening&lt;br/&gt;(disallowedTools: Strip bash/write from PM &amp; Docs)\&quot;]           \n            WORKTREES[\&quot;Isolated Git Worktrees&lt;br/&gt;(Hermes / Claude / Codex Agents)\&quot;]                                 \n                                                                                                                     \n            WALL --&gt;|\&quot;Claim Task\&quot;| HOOKS                                                                             \n            HOOKS --&gt;|\&quot;Enforce Boundary\&quot;| ROLES                                                                      \n            ROLES --&gt;|\&quot;Safe Execution\&quot;| WORKTREES                                                                    \n        end                                                                                                          \n                                                                                                                     \n        %% ==========================================                                                                \n        %% MEMORY &amp; SELF-CORRECTION                                                                                  \n        %% ==========================================                                                                \n        subgraph MEMORY[\&quot;5. Tiered Memory &amp; Failure Alchemy\&quot;]                                                        \n            direction TB                                                                                             \n            L0[\&quot;L0: High-Level Index &amp; Summaries (Lean Context)\&quot;]                                                    \n            L1[\&quot;L1: Domain &amp; Subsystem Rollups (Mid Context)\&quot;]                                                       \n            L2[\&quot;L2: Raw Code, Schemas &amp; Detailed Logs (Deep Context)\&quot;]                                               \n                                                                                                                     \n            ANTIDOTE[\&quot;Failure Antidote Engine&lt;br/&gt;(Analyze Crash/Test Failures → Extract Fix Recipe)\&quot;]               \n            SQLITE[(\&quot;Local SQLite WAL Ledger&lt;br/&gt;Zero-latency task state &amp; audit trail\&quot;)]                            \n                                                                                                                     \n            L0 --&gt; L1 --&gt; L2                                                                                         \n            WORKTREES -.-&gt;|\&quot;Test/Build Failure\&quot;| ANTIDOTE                                                            \n            ANTIDOTE --&gt;|\&quot;Save Antidote\&quot;| L1                                                                         \n            WORKTREES &lt;--&gt;|\&quot;Query Context on Demand\&quot;| L0                                                             \n            HOOKS &lt;--&gt;|\&quot;Fast State Checkpoint\&quot;| SQLITE                                                               \n        end                                                                                                          \n                                                                                                                     \n        %% Cross-layer styling                                                                                       \n        style GOV fill:#1e293b,stroke:#3b82f6,stroke-width:2px,color:#f8fafc                                         \n        style MEETINGS fill:#0f172a,stroke:#8b5cf6,stroke-width:2px,color:#f8fafc                                    \n        style TASKWALL fill:#0f172a,stroke:#eab308,stroke-width:2px,color:#f8fafc                                    \n        style EXEC fill:#0f172a,stroke:#10b981,stroke-width:2px,color:#f8fafc                                        \n        style MEMORY fill:#1e293b,stroke:#ec4899,stroke-width:2px,color:#f8fafc&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ziXE-hFs8-kJTOPbrniI-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
