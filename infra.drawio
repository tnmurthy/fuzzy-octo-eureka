    <mxGraphModel dx="2375" dy="1371" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\n\n    classDiagram\n        class ReBACEngine {\n            +Map nodes\n            +Array edges\n            +addNode(id, label, props)\n            +addEdge(fromId, relation, toId)\n            +canAccess(actorId, action, resourceId) Object\n            -_nodeHasAction(nodeId, resourceId, action) Boolean\n        }\n\n        class Server {\n            +PORT: 8787\n            +TELEMETRY_FILE: String\n            +HISTORY_FILE: String\n            +serveStaticFile(req, res)\n            +serveJsonFile(res, filePath, emptyValue)\n            +handlePing(req, res)\n        }\n\n        class TelemetryDaemon {\n            +PollIntervalSeconds: 5\n            +HistoryMaxPoints: 720\n            +Get-HostCpuLoad() Float\n            +Test-TcpPortOpen(Host, Port) Hashtable\n            +Test-OllamaHandshake(Host, Port) Hashtable\n            +Get-WatchtowerStatus() Hashtable\n            +Get-ActiveOllamaModels() Array\n            +Write-AtomicJsonFile(Path, Data)\n        }\n\n        class MiniChart {\n            +canvasId: String\n            +color: String\n            +maxVal: Number\n            +data: Array\n            +resize()\n            +addData(val)\n            +setData(values)\n            +draw()\n        }\n\n        class DashboardFrontend {\n            +telemetryLive: Boolean\n            +lastTelemetryData: Object\n            +pollTelemetry()\n            +seedChartsFromHistory()\n            +testOllamaHandshake()\n            +updateServiceDots(data)\n            +updateEngineStatsPanel(data)\n        }\n\n        Server --&gt; ReBACEngine : Authorizes Ping Requests\n        TelemetryDaemon ..&gt; Server : Produces telemetry.json &amp; history.json\n        DashboardFrontend --&gt; Server : Consumes APIs via fetch()\n        DashboardFrontend *-- MiniChart : Renders Latency &amp; CPU Canvas Trends\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="WGP695oMDk8lTbK6rXjP-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
