        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot; sequenceDiagram                                                                                                  \n        autonumber                                                                                                   \n        actor Human as Chairman (Human)                                                                              \n        participant CEO as AI Leader / CEO                                                                           \n        participant Meeting as Meeting Engine (DACI / 6 Hats)                                                        \n        participant Wall as Task Wall &amp; Watchdog                                                                     \n        participant Hooks as Lifecycle Hooks                                                                         \n        participant Worker as Specialist Agent (Worktree)                                                            \n        participant Mem as Memory (L0-L2 &amp; Antidotes)                                                                \n                                                                                                                     \n        Human-&gt;&gt;CEO: Submit high-level feature goal                                                                  \n        CEO-&gt;&gt;Meeting: Convene DACI / Six Hats debate session                                                        \n        Meeting--&gt;&gt;CEO: Output ratified decisions.md                                                                 \n        CEO-&gt;&gt;Wall: Create atomic tasks with dependency graph                                                        \n                                                                                                                     \n        loop Task Execution                                                                                          \n            Wall-&gt;&gt;Hooks: Dispatch next unblocked task                                                               \n            Hooks-&gt;&gt;Worker: Inject role boundary (disallowedTools)                                                   \n            Worker-&gt;&gt;Mem: Fetch L0 summary (expand to L2 only if needed)                                             \n                                                                                                                     \n            alt Context approaches token limit                                                                       \n                Hooks-&gt;&gt;Hooks: PreCompact Hook: Freeze battle state &amp; active tasks                                   \n            end                                                                                                      \n                                                                                                                     \n            alt Agent Encounters Failure / CI Break                                                                  \n                Worker-&gt;&gt;Mem: Query Failure Antidotes for matching fix                                               \n                Worker-&gt;&gt;Hooks: Execute test / build                                                                 \n                Hooks-&gt;&gt;Wall: TurnEndGuard: Prevent completion until tests pass                                      \n            end                                                                                                      \n                                                                                                                     \n            Worker-&gt;&gt;Wall: Task complete &amp; branch committed                                                          \n        end                                                                                                          \n                                                                                                                     \n        Wall--&gt;&gt;CEO: All subtasks cleared (Zero deadlocks)                                                           \n        CEO--&gt;&gt;Human: Present final PR &amp; verification report  &quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="CnAWxkwsMWV0vCtmCjxm-1">
